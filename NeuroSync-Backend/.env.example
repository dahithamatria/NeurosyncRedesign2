# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:password@localhost:5432/neurosync"

# JWT
JWT_SECRET="change-this-secret"
JWT_EXPIRES_IN="7d"

# CORS — must match the Vite dev server origin (react-app's default port)
FRONTEND_URL="http://localhost:5173"

# Optional AI provider for /api/ai/simplify and /api/ai/summarize.
# Leave blank to run with the built-in dev fallback (see src/services/aiService.js).
AI_API_KEY=""
AI_MODEL="gemini-2.5-flash"
